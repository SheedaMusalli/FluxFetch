{
  "manifest_version": 3,
  "name": "FluxFetch Download Manager",
  "version": "1.4.0",
  "description": "Send downloads and direct media links to the FluxFetch Windows app.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "webRequest",
    "cookies",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FluxFetch downloads",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://youtube.com/*", "https://*.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fluxfetch@fluxfetch.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
